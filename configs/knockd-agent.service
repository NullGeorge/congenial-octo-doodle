# The agent only reads the knockd journal and writes its own state database,
# so it is granted no capabilities at all. Reading the live nftables ruleset
# would require CAP_NET_ADMIN, which equally permits flushing the whole
# firewall; access lifetimes are taken from the knockd log instead.
#
# One-time setup:
#   useradd --system --user-group --no-create-home --shell /usr/sbin/nologin knockd-agent
#   install -m 0755 knockd-agent /usr/local/bin/knockd-agent

[Unit]
Description=knockd agent
Documentation=https://github.com/NullGeorge/congenial-octo-doodle
After=knockd.service
Wants=knockd.service

[Service]
Type=simple
# Country labels are optional. Fetch the range table, drop it next to the
# database and append: -geoip /var/lib/knockd-agent/country.csv
#   https://github.com/sapics/ip-location-db/releases/download/latest/user-country-ipv4-num.csv
# A path given here must exist, otherwise start-up fails on purpose.
# Adding -helper /usr/local/sbin/knock-helper turns on /allow, /revoke and
# /knockd from the chat. It also requires configs/sudoers.knockd-agent and the
# capability changes described further down. Without it the bot is read only.
ExecStart=/usr/local/bin/knockd-agent run -service knockd
User=knockd-agent
Group=knockd-agent

# BOT_TOKEN and CHAT_ID live here, one KEY=value per line. systemd reads this
# as root before dropping privileges, so the file can be 0600 root:root and
# still reach an unprivileged service. Keeping the token out of ExecStart is
# the point: process arguments are world readable through ps.
EnvironmentFile=-/etc/knockd-agent.env

# The journal is reachable through group membership, not through root: the
# directory is root:systemd-journal with an ACL. Drop this line and the agent
# reads nothing, which is the intended failure mode.
SupplementaryGroups=systemd-journal

# Creates /var/lib/knockd-agent owned by the service user, which is where the
# default -db path points.
StateDirectory=knockd-agent

# As shipped the agent watches and reports, and needs no capability at all.
#
# Enabling /allow, /revoke and /knockd means borrowing root through sudo, and
# sudo is setuid: it cannot function under either of the two settings below.
# Measured on a Debian 12 host, with the helper installed and sudoers in place:
#   CapabilityBoundingSet= (empty) -> sudo: unable to change to root gid
#   NoNewPrivileges=true           -> sudo: the "no new privileges" flag is set
# The bounding set also caps what root itself may hold, so without CAP_NET_ADMIN
# the helper reaches nft and is refused with "you must be root".
#
# To turn commands on, add -helper to ExecStart and replace the three lines
# below with:
#   CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_NET_ADMIN CAP_AUDIT_WRITE
#   NoNewPrivileges=false
# The daemon still holds no capability of its own. That set only bounds what a
# setuid exec may gain, and sudoers permits exactly one binary.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
RestrictSUIDSGID=true

# The state database records every knock and every address that reached this
# host. Default permissions would leave it world readable.
UMask=0077

ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
